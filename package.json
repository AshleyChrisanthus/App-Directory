{
  "name": "app-directory",
  "version": "1.0.0",
  "private": true,
  "description": "App Directory - Bookmarks and Web Applications Manager",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --outfile=app.js --format=iife --target=es2020 --sourcemap",
    "typecheck": "tsc --noEmit",
    "watch": "esbuild src/main.ts --bundle --outfile=app.js --format=iife --target=es2020 --sourcemap --watch",
    "deploy": "node scripts/deploy_herenow.js"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.7.3"
  }
}
